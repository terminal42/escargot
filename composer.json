{
    "name": "terminal42/escargot",
    "description": "A web crawler or spider library based on Symfony components",
    "type": "library",
    "license": "MIT",
    "keywords": ["escargot", "index", "search", "crawl", "spider"],
    "homepage": "https://www.terminal42.ch",
    "authors": [
        {
            "name": "Yanick Witschi",
            "homepage": "https://github.com/toflar",
            "role": "Developer"
        }
    ],
    "support": {
        "source": "https://github.com/terminal42/escargot"
    },
    "require": {
        "php": "^8.1",
        "ext-dom": "*",
        "ext-simplexml": "*",
        "nyholm/psr7": "^1.1",
        "psr/http-message": "^1.0 || ^2.0",
        "psr/log": "^1.1 || ^2.0 || ^3.0",
        "symfony/clock": "^6.2 || ^7.0 || ^8.0",
        "symfony/dom-crawler": "^5.4 || ^6.0 || ^7.0 || ^8.0",
        "symfony/http-client": "^5.4 || ^6.0 || ^7.0 || ^8.0",
        "symfony/http-client-contracts": "^3.6",
        "webignition/robots-txt-file": "^3.0"
    },
    "require-dev": {
        "doctrine/dbal": "^3.10 || ^4.0",
        "fig/log-test": "^1.0",
        "phpunit/phpunit": "^10.5.60 || ^11.5 || ^12.5 || ^13.0",
        "symfony/finder": "^5.4|| ^6.0 || ^7.0 || ^8.0",
        "terminal42/code-quality-tools": "@dev"
    },
    "config": {
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true,
        "allow-plugins": {
            "terminal42/code-quality-tools": true
        }
    },
    "autoload": {
        "psr-4": {
            "Terminal42\\Escargot\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Terminal42\\Escargot\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "cs-fixer": "@php vendor/terminal42/code-quality-tools/tools/ecs/vendor/bin/ecs check src tests --config vendor/terminal42/code-quality-tools/tools/ecs/config.php --ansi",
        "rector": "@php vendor/terminal42/code-quality-tools/tools/rector/vendor/bin/rector process src tests --config vendor/terminal42/code-quality-tools/tools/rector/config.php --dry-run --ansi",
        "phpstan": "@php vendor/terminal42/code-quality-tools/tools/phpstan/vendor/bin/phpstan analyze src tests --configuration vendor/terminal42/code-quality-tools/tools/phpstan/config.php --ansi",
        "composer-dependencies": "@php vendor/terminal42/code-quality-tools/tools/composer-dependency-analyser/vendor/bin/composer-dependency-analyser --config vendor/terminal42/code-quality-tools/tools/composer-dependency-analyser/config.php",
        "yaml-lint": "@php vendor/terminal42/code-quality-tools/tools/yamllint/vendor/bin/yaml-lint .github",
        "code-quality": [
            "@cs-fixer",
            "@rector",
            "@phpstan",
            "@composer-dependencies",
            "@yaml-lint"
        ]
    }
}
